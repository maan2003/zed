#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

exec nix run --impure github:nix-community/nixGL#nixGLDefault -- \
    bash -lc '
        cd "$1"
        shift
        "${CARGO:-cargo}" test -p zed visual_test_smoke --features visual-tests -- --ignored --nocapture "$@"
    ' bash "$repo_root" "$@"
